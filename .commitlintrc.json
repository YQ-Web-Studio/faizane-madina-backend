{
  "extends": [
    "@commitlint/config-conventional"
  ],
  "parserPreset": {
    "parserOpts": {
      "headerPattern": "^(?:\\[(FMMS-\\d+)\\]\\s+)?(\\w+)(?:\\(([^)]+)\\))?:\\s+(.+)$",
      "headerCorrespondence": [
        "ticket",
        "type",
        "scope",
        "subject"
      ]
    }
  },
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert"
      ]
    ],
    "subject-case": [
      0
    ]
  }
}
